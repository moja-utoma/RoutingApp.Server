{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Trace",
      "System": "Error"
    }
  },
  "ConnectionStrings": {
    "RoutingDB": "Server=YOUR_SERVER_NAME;Database=RoutingDB;Trusted_Connection=True;"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "Audience": "api://"
  },
  "OpenRouteService": {
    "ApiKey": "api_key"
  },
  "auth0": {
    "Authority": "",
    "Audience": ""
  },
  "ServiceBus": {
    "QueueName": "route-queue",
    "ConnectionString": "YOUR-LOCAL-CONNECTION-STRING"
  },
  "BlobStorage": {
    "ConnectionString": "",
    "ContainerName": ""
  },
  "ApplicationInsights": {
    "ConnectionString": "InstrumentationKey="
  },
  "AzureKeyVault": {
    "VaultUri": "https://myappkeyvault.vault.azure.net/"
  },
  "AzureOpenAI": {
    "Endpoint": "https://<your-resource-name>.openai.azure.com/",
    "Key": "<your-api-key>",
    "DeploymentName": "gpt-4.1-mini"
  },
  "AzureAISearch": {
    "Endpoint": "https://YOUR-SEARCH-SERVICE-NAME.search.windows.net",
    "Key": "YOUR-SEARCH-ADMIN-KEY",
    "IndexName": "YOUR-INDEX-NAME"
  },
  "AllowedHosts": "*"
